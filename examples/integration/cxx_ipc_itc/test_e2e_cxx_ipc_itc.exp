#### Common Setup

set REPO_ROOT [exec git rev-parse --show-toplevel]
cd ${REPO_ROOT}

source ${REPO_ROOT}/internal/end-to-end-testing/common.exp
source ${REPO_ROOT}/examples/integration/common.exp

#### Test Setup

set timeout 10

# ITC: producer and consumer thread in one process; it stops by itself after
# five samples.
spawn ${BIN_DIR}/itc_local
set id_itc $spawn_id

expect_output_from $id_itc "sent sample 0"
expect_output_from $id_itc "sample 1, latency * ns"
expect_output_from $id_itc "sent sample 4"
expect_exit_success $id_itc "itc_local"

# IPC: publisher and subscriber process.
spawn ${BIN_DIR}/ipc_subscriber
set id_subscriber $spawn_id
expect_output_from $id_subscriber "subscriber ready"

spawn ${BIN_DIR}/ipc_publisher
set id_publisher $spawn_id

#### Test Assertion

expect_output_from $id_publisher "sent sample 2"
expect_output_from $id_subscriber "received sample 2, latency * ns"

# Ctrl+C: both must shut down cleanly.
send -i $id_publisher $SIGINT
send -i $id_subscriber $SIGINT
expect_exit_success $id_publisher "ipc_publisher"
expect_exit_success $id_subscriber "ipc_subscriber"

show_test_passed
